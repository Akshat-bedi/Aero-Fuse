{
  "$defs": {
    "CrewStatus": {
      "enum": [
        "available",
        "resting",
        "on-mission",
        "unavailable"
      ],
      "title": "CrewStatus",
      "type": "string"
    }
  },
  "properties": {
    "baseId": {
      "title": "Baseid",
      "type": "string"
    },
    "callsign": {
      "minLength": 1,
      "title": "Callsign",
      "type": "string"
    },
    "dutyHoursLast24h": {
      "maximum": 24,
      "minimum": 0,
      "title": "Dutyhourslast24H",
      "type": "number"
    },
    "fatigueIndex": {
      "maximum": 100,
      "minimum": 0,
      "title": "Fatigueindex",
      "type": "number"
    },
    "id": {
      "pattern": "^CR-",
      "title": "Id",
      "type": "string"
    },
    "qualifications": {
      "items": {
        "type": "string"
      },
      "title": "Qualifications",
      "type": "array"
    },
    "restHoursRemaining": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resthoursremaining"
    },
    "role": {
      "minLength": 1,
      "title": "Role",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CrewStatus"
    }
  },
  "required": [
    "id",
    "callsign",
    "role",
    "baseId",
    "fatigueIndex",
    "dutyHoursLast24h",
    "status"
  ],
  "title": "Crew",
  "type": "object"
}
