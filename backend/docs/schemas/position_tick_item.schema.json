{
  "$defs": {
    "LatLng": {
      "description": "Point inside the fictional Republic of Veridia map bounds.",
      "properties": {
        "lat": {
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 12.0,
          "minimum": 0.0,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "title": "LatLng",
      "type": "object"
    }
  },
  "description": "One aircraft entry inside the ``POSITION_TICK`` payload array.",
  "properties": {
    "fuelPct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fuelpct"
    },
    "heading": {
      "anyOf": [
        {
          "maximum": 360,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heading"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "position": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatLng"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "speed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed"
    }
  },
  "required": [
    "id"
  ],
  "title": "PositionTickItem",
  "type": "object"
}
