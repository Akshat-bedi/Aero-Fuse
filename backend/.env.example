# AirOps DSS backend configuration.
# Copy to .env and adjust; NEVER commit the .env file itself.

# Deterministic seed for the simulated world and any randomised behaviour.
SEED=42

# Canonical world seed file. Defaults to the repo-relative
# shared/seed/world.json next to the backend/ directory; override when the
# layout differs (for example in Docker, see docker-compose.yml).
# SEED_PATH=../shared/seed/world.json

# HTTP server bind address.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# Persistence for audit / decisions / scenarios (live state stays in memory).
DB_URL=sqlite:///./airops.db

# Local RBAC for demo purposes; disabled by default. To enable, set
# AUTH_ENABLED=true and provide JWT_SECRET (>=32 chars) from the environment.
AUTH_ENABLED=false
JWT_SECRET=dev-only-change-me

# Auth/session tuning (only used when AUTH_ENABLED=true).
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=28800
ABSOLUTE_SESSION_LIMIT_SEC=43200
LOCKOUT_FAILURES=5
LOCKOUT_DURATION_SEC=300
STEP_UP_WINDOW_SEC=300
HIGH_IMPACT_MISSION_THRESHOLD=3
TWO_PERSON_REQUIRED=true
DEMO_DEFAULT_OPERATOR=demo-commander

# Optimiser / recommendation tuning (B5+). Pending recommendations expire
# after RECO_TTL_MIN simulation minutes (B8a).
SOLVER_TIME_LIMIT_S=4.0
RECO_TTL_MIN=90
STALE_DATA_SEC=30

# Simulation clock start (matches shared/seed/world.json sim.time) and speed.
SIM_START_TIME=2026-10-17T12:00:00.000Z
SIM_DEFAULT_SPEED=1
